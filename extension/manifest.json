{
  "manifest_version": 3,
  "name": "IDM Clone Integration",
  "version": "1.1",
  "description": "Integration module for IDM Clone",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:6800/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}